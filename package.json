{
  "name": "escrowflow",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "dev": "pnpm --filter @escrowflow/web dev",
    "build": "pnpm typecheck && pnpm --filter @escrowflow/web build",
    "lint": "pnpm --filter @escrowflow/web lint && pnpm --filter @escrowflow/ui lint && pnpm --filter @escrowflow/types lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "contracts:compile": "pnpm --filter @escrowflow/contracts compile",
    "contracts:test": "pnpm --filter @escrowflow/contracts test",
    "contracts:deploy:stack": "pnpm --filter @escrowflow/contracts deploy:stack",
    "contracts:deploy:registry": "pnpm --filter @escrowflow/contracts deploy:registry",
    "contracts:deploy:mock-token": "pnpm --filter @escrowflow/contracts deploy:mock-token"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@prisma/client": "6.19.3",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.10",
    "prisma": "6.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  }
}
