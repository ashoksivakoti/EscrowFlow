{
  "name": "escrowflow",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "dev": "pnpm --filter @escrowflow/web dev",
    "build": "pnpm typecheck && pnpm --filter @escrowflow/web build",
    "lint": "pnpm --filter @escrowflow/web lint && pnpm --filter @escrowflow/ui lint && pnpm --filter @escrowflow/types lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.mjs",
    "db:seed:public-marketplace": "node prisma/scripts/seed-public-marketplace-for-wallet.mjs",
    "db:link-project-on-chain": "node prisma/scripts/link-project-on-chain-fields.mjs",
    "web:validate:env": "pnpm --filter @escrowflow/web validate:env",
    "web:sanity:contract": "pnpm --filter @escrowflow/web sanity:contract",
    "ci:release:web": "pnpm web:validate:env && pnpm web:sanity:contract && pnpm --filter @escrowflow/web build",
    "event-sync:trigger": "pnpm --filter @escrowflow/web event-sync:trigger",
    "contracts:compile": "pnpm --filter @escrowflow/contracts compile",
    "contracts:test": "pnpm --filter @escrowflow/contracts test",
    "contracts:deploy:canonical:registry": "pnpm --filter @escrowflow/contracts deploy:canonical:registry",
    "contracts:setup:canonical:registry": "pnpm --filter @escrowflow/contracts setup:canonical:registry",
    "contracts:sanity:canonical:registry": "pnpm --filter @escrowflow/contracts sanity:canonical:registry",
    "contracts:verify:canonical:registry": "pnpm --filter @escrowflow/contracts verify:canonical:registry",
    "contracts:cutover:registry:refs": "pnpm --filter @escrowflow/contracts cutover:registry:refs"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@prisma/client": "6.19.3",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.10",
    "prisma": "6.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  }
}
