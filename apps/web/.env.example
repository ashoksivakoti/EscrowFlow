# =============================================================================
# EscrowFlow — Next.js app (`apps/web`)
# Copy to `apps/web/.env.local` for local development.
# =============================================================================

# Prisma reads DATABASE_URL from the environment.
DATABASE_URL="postgresql://user:password@localhost:5432/escrowflow?schema=public"

# Public chain configuration (RainbowKit / wagmi — comma-separated chain IDs)
NEXT_PUBLIC_CHAIN_IDS="421614,31337"
# WalletConnect Cloud project id (https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID="your_walletconnect_project_id"
# Optional defaults for create-project UX (prefills form fields)
# NEXT_PUBLIC_DEFAULT_CHAIN_ID="421614"
# NEXT_PUBLIC_DEFAULT_ESCROW_REGISTRY_ADDRESS="0xYOUR_ESCROW_REGISTRY_ON_ARBITRUM_SEPOLIA"
# NEXT_PUBLIC_DEFAULT_PAYMENT_TOKEN_ADDRESS="0xYOUR_PAYMENT_TOKEN_ON_ARBITRUM_SEPOLIA"

# SIWE + session (see docs/auth.md)
AUTH_SECRET="replace-with-at-least-32-random-chars----------------"
AUTH_SIWE_DOMAIN="localhost:3000"
AUTH_SIWE_URI="http://localhost:3000"
AUTH_ALLOWED_CHAIN_IDS="421614,31337"
# AUTH_SESSION_MAX_AGE_SECONDS=604800
# AUTH_NONCE_TTL_SECONDS=300
# AUTH_ADMIN_WALLETS="0xabc...,0xdef..."

# IPFS (server-only)
IPFS_PINATA_JWT=""
IPFS_PINATA_API_BASE_URL="https://api.pinata.cloud"
IPFS_GATEWAY_HOST="gateway.pinata.cloud"
# IPFS_MAX_FILE_BYTES=26214400
# IPFS_MAX_JSON_BYTES=1048576
# IPFS_ALLOWED_MIME_TYPES="application/pdf,application/json,text/plain,text/markdown,image/png,image/jpeg,image/webp"
# IPFS_UPLOAD_TIMEOUT_MS=30000
# If true, project agreement upload falls back to null URI when IPFS is down.
# Keep false in strict production pipelines.
# IPFS_ALLOW_AGREEMENT_FALLBACK=false

# Contract defaults for backend project creation (server-only)
# CONTRACTS_DEFAULT_CHAIN_ID=421614
# CONTRACTS_ESCROW_REGISTRY_ADDRESS="0xYOUR_ESCROW_REGISTRY_ON_ARBITRUM_SEPOLIA"
# CONTRACTS_PAYMENT_TOKEN_ADDRESS="0xYOUR_PAYMENT_TOKEN_ON_ARBITRUM_SEPOLIA"
# Optional JSON artifact path (relative to repo root or absolute path)
# CONTRACTS_DEPLOYMENT_PATH="packages/contracts/deployments/arbitrumSepolia-421614.json"

# Event sync worker/service (server-only)
EVENT_SYNC_RPC_URL="https://arb-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY"
EVENT_SYNC_CHAIN_ID=421614
EVENT_SYNC_CONTRACT_ADDRESS="0xYOUR_ESCROW_REGISTRY_ON_ARBITRUM_SEPOLIA"
# EVENT_SYNC_SCOPE="ESCROW_REGISTRY:0x..."
# EVENT_SYNC_START_BLOCK=0
# EVENT_SYNC_BATCH_SIZE=500
# EVENT_SYNC_CONFIRMATIONS=2
# EVENT_SYNC_RPC_RETRIES=2
# EVENT_SYNC_RPC_RETRY_DELAY_MS=800
# EVENT_SYNC_TRIGGER_TOKEN="replace-with-strong-random-token"
# For script-based trigger (`pnpm event-sync:trigger`)
# EVENT_SYNC_INTERNAL_URL="http://127.0.0.1:3000"
# EVENT_SYNC_TRIGGER_RETRIES=2
# EVENT_SYNC_TRIGGER_RETRY_DELAY_MS=1200
