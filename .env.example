# =============================================================================
# EscrowFlow — root / shared environment
# Copy to `.env` at the repo root for Prisma CLI and tooling.
# App-specific variables live in `apps/web/.env.example`.
# =============================================================================

# PostgreSQL connection string (Prisma)
# Example: postgresql://user:password@localhost:5432/escrowflow?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/escrowflow?schema=public"

# Optional: default chain id for scripts/tooling (not used by the web app directly)
# NEXT_PUBLIC_* vars belong in apps/web — see apps/web/.env.example
