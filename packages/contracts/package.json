{
  "name": "@escrowflow/contracts",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:canonical:registry": "hardhat run scripts/deploy-canonical-registry.ts",
    "sweep:untracked": "hardhat run scripts/sweep-untracked-token.ts",
    "setup:canonical:registry": "hardhat run scripts/setup-canonical-registry.ts",
    "sanity:canonical:registry": "hardhat run scripts/sanity-check-canonical-registry.ts",
